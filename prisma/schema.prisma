generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id         Int       @id @default(autoincrement())
  username   String
  email      String    @unique
  password   String
  created_At DateTime  @default(now())

  Sessions   Session[]
}

model Session {
  id         Int      @id @default(autoincrement())
  userId     Int
  expired_At DateTime

  user       User     @relation(fields: [userId], references: [id])
}